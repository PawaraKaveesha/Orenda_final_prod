# =====================================================================
# Backend (Express API) — environment variables
# Copy this file to `server/.env` for local development.
# NEVER commit a real `.env` file. In production (Render) the values
# are provided by Render Environment Variables — no .env file needed.
# =====================================================================

# ---------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------

# MongoDB connection string (local or hosted, e.g. MongoDB Atlas).
MONGODB_URI=mongodb+srv://<db_username>:<db_username>@orenda.whhwyt5.mongodb.net/?appName=Orenda

# Secret used to sign admin JWT sessions.
JWT_SECRET=5331bd6b2f806dea95c900c1a9de479b5ca0597d1f51b89b2bc3520ad1ff64db774f1a66a54de1eb108d82bb15371945

# ---------------------------------------------------------------------
# OPTIONAL (defaults shown)
# ---------------------------------------------------------------------

# JWT session lifetime.
JWT_EXPIRES_IN=7d

# development | production
NODE_ENV=development

# API port.
PORT=5000

# Comma-separated list of allowed CORS origins (* in development).
CORS_ORIGIN=*

# ---------------------------------------------------------------------
# SEEDING ONLY (npm run db:setup) — initial admin account
# ---------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
