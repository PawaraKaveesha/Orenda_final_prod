# =====================================================================
# Orenda API — environment variables
# Copy this file to `.env` (or set the variables in Render) and fill in
# the values. NEVER commit a real `.env` file.
#
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# SERVER (both local and production)
# ---------------------------------------------------------------------

# Port the Express server listens on.
# Render injects PORT automatically; locally it defaults to 5000.
PORT=5000

# "development" locally, "production" on Render.
NODE_ENV=development

# Comma-separated list of allowed browser origins (CORS).
#   LOCAL:      http://localhost:5173
#   PRODUCTION: https://your-frontend.pages.dev
FRONTEND_URL=http://localhost:5173

# JWT secret — REQUIRED. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime (default 7d).
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------
# POSTGRESQL — use EITHER a single DATABASE_URL (production) OR the
# individual DB_* variables (local development).
# ---------------------------------------------------------------------

# Preferred connection string. On Render, paste the connection string from
# your Neon / Render Postgres / Supabase dashboard. Keep it empty to use the
# DB_* variables below.
DATABASE_URL=

# Enable TLS for hosted PostgreSQL providers (Neon, Render Postgres, ...).
# Set to "true" in production. Verification stays ON by default; only set
# DB_SSL_INSECURE=true if your provider uses an unverifiable certificate.
DB_SSL=false

# Only used when DATABASE_URL is empty (local development).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orenda_galle
DB_USER=postgres
DB_PASSWORD=postgres

# ---------------------------------------------------------------------
# INITIAL ADMIN ACCOUNT (created by `npm run db:setup`)
# ---------------------------------------------------------------------
# Used ONLY to seed the first admin. The password is hashed with bcrypt
# before it is stored — it is never written to the database in plaintext.
# The seeded admin must change this password on first sign-in.
ADMIN_EMAIL=admin@orendaresort.com
ADMIN_PASSWORD=use-a-strong-password-at-least-8-characters

# ---------------------------------------------------------------------
# OPTIONAL TUNING (defaults shown)
# ---------------------------------------------------------------------

# Rate limiting: window in ms and max requests per window (global API limiter).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Multer uploads are currently not wired to any route, but these configure
# them if enabled later. Render's filesystem is EPHEMERAL — uploaded files
# are lost on redeploy; store uploads elsewhere if you add an upload route.
UPLOAD_DIR=public/images/uploads
MAX_UPLOAD_MB=5

# Logging level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# =====================================================================
# LOCAL DEVELOPMENT quick reference
# =====================================================================
#   PORT=5000
#   NODE_ENV=development
#   FRONTEND_URL=http://localhost:5173
#   JWT_SECRET=<random>
#   DB_HOST=localhost
#   DB_PORT=5432
#   DB_NAME=orenda_galle
#   DB_USER=postgres
#   DB_PASSWORD=<your local password>
#   DATABASE_URL=
#   DB_SSL=false
#   ADMIN_EMAIL=admin@orendaresort.com
#   ADMIN_PASSWORD=<your local dev password>
#
# =====================================================================
# PRODUCTION (Render) quick reference
# =====================================================================
#   PORT=10000                     (Render sets this)
#   NODE_ENV=production
#   FRONTEND_URL=https://your-frontend.pages.dev
#   JWT_SECRET=<long random string>
#   DATABASE_URL=postgresql://...  (from Neon / Render Postgres)
#   DB_SSL=true
#   ADMIN_EMAIL=<your email>
#   ADMIN_PASSWORD=<strong password>
#   (DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD stay empty)
# =====================================================================
