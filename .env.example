# =====================================================================
# Frontend (Vite) — environment variables
# Copy this file to `.env` for local builds, or set the variables in
# your hosting platform (Cloudflare Pages, Vercel, ...).
# NEVER commit a real `.env` file.
# =====================================================================

# ---------------------------------------------------------------------
# LOCAL DEVELOPMENT (Vite dev server)
# ---------------------------------------------------------------------

# Backend the Vite dev proxy forwards /api and /images to.
VITE_API_TARGET=http://localhost:5000

# Leave empty in local development — the Vite proxy handles /api + /images.
VITE_API_URL=

# ---------------------------------------------------------------------
# PRODUCTION (Cloudflare Pages build)
# ---------------------------------------------------------------------
# Full URL of the deployed Render backend. The frontend will call this
# origin for /api/* requests AND prefix relative server image paths
# (/images/*) with it.
#
#   VITE_API_URL=https://orenda-api.onrender.com
#
# The backend's CORS setting (FRONTEND_URL) must allow the Cloudflare
# Pages origin, e.g. https://orenda-galle.pages.dev
# =====================================================================
